# HZDR data locations and event streams
DAMNIT_HZDR_DATA_ROOT=C:\data\hzdr
DAMNIT_HZDR_KAFKA_BROKER=kafka.hzdr.example:9092
DAMNIT_HZDR_KAFKA_TOPIC=labfrog.runs
DAMNIT_HZDR_UPDATE_BROKER=kafka.hzdr.example:9092

# LabFrog / ShotSheet MongoDB
DAMNIT_MONGODB_LABFROG_URI=mongodb://user:password@mongo.hzdr.example:27017

# Use the active DAMNIT environment for local starter sites.
DAMNIT_CONTEXT_PYTHON=
DAMNIT_DAMNIT_PYTHON=

# Optional auth settings
DAMNIT_LDAP_SERVER=ldap.example.org
DAMNIT_LDAP_BASE_DN=dc=example,dc=org
DAMNIT_HELMHOLTZ_ISSUER=https://login.helmholtz.de/auth/realms/helmholtz
DAMNIT_HELMHOLTZ_CLIENT_ID=damnit

# Planned future ingestion modes
DAMNIT_HZDR_HDF5_WATCH_DIR=C:\data\hzdr\incoming-hdf5
DAMNIT_HZDR_BIGDATA_ENDPOINT=https://bigdata.hzdr.example/api
DAMNIT_HZDR_BIGDATA_TOKEN=
